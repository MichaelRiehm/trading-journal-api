# Copy to .env and adjust. .env is gitignored; never commit real secrets.
# Each later stage adds the settings it introduces here.

# --- Postgres (docker compose) ---
POSTGRES_USER=journal
POSTGRES_PASSWORD=journal-dev-password
POSTGRES_DB=journal
# Host port for Postgres (bound to 127.0.0.1 only)
POSTGRES_PORT=5432

# --- API ---
# Host port for the API container (bound to 127.0.0.1 only)
API_PORT=8000
# Connection string for running the app on the host (uv run ...). Inside compose, the api
# service builds its own DATABASE_URL pointing at the db container. Read by the app from Stage 1.
DATABASE_URL=postgresql+psycopg://journal:journal-dev-password@localhost:5432/journal
