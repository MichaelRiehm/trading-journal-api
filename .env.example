# Copy to .env and adjust. .env is gitignored; never commit real secrets.
# Each later stage adds the settings it introduces here.

# --- Postgres (docker compose) ---
POSTGRES_USER=journal
POSTGRES_PASSWORD=journal-dev-password
POSTGRES_DB=journal
# Host port for Postgres (bound to 127.0.0.1 only)
POSTGRES_PORT=5432

# --- API ---
# Host port for the API container (bound to 127.0.0.1 only)
API_PORT=8000
# Connection string for running the app, migrations and tests on the host (uv run ...).
# Inside compose, the api and migrate services build their own DATABASE_URL pointing at
# the db container.
# Use 127.0.0.1, not localhost: localhost tries IPv6 (::1) first, and Docker Desktop on
# Windows publishes only on 127.0.0.1, so connections stall before falling back.
DATABASE_URL=postgresql+psycopg://journal:journal-dev-password@127.0.0.1:5432/journal
# Optional. Tests create, migrate and drop this database. Defaults to DATABASE_URL with
# "_test" appended to the database name.
# TEST_DATABASE_URL=postgresql+psycopg://journal:journal-dev-password@127.0.0.1:5432/journal_test

# --- Auth (Stage 2, see docs/decisions/0005-access-tokens.md) ---
# Required, at least 32 characters. Signs access tokens (HS256). Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Tests use their own throwaway key, so this is only needed to run the API.
JWT_SECRET_KEY=
# Access token lifetime. There are no refresh tokens: log in again after it expires.
ACCESS_TOKEN_EXPIRE_MINUTES=60
